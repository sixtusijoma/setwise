# Leave empty to run in local mode. Public by design: only the project URL and anon/publishable key.
# Prefer the publishable key (sb_publishable_…) in EXPO_PUBLIC_SUPABASE_ANON_KEY.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Used only by scripts/rls-smoke.mjs and the hosted auth e2e. Never commit a real password.
# RLS_SMOKE_PASSWORD=
# E2E_PASSWORD=
